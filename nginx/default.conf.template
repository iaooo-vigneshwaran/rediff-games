server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    location = /chess { return 308 /chess/; }
    location = /checkers { return 308 /checkers/; }
    location = /backgammon { return 308 /backgammon/; }
    location = /solitaire { return 308 /solitaire/; }
    location = /sudoku { return 308 /sudoku/; }

    location = /api/auth/session {
        proxy_pass http://auth-backend:3000/api/auth/session;
        proxy_set_header Cookie $http_cookie;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location = /_auth_check {
        internal;
        proxy_pass http://auth-backend:3000/api/auth/session;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }

    # Local development login only. Replace with Rediff's approved login flow.
    location = /auth/login {
        add_header Cache-Control "no-store" always;
        try_files /dev-login.html =404;
    }

    # Keep logout separate so it can later redirect to Rediff logout.
    location = /auth/logout {
        add_header Cache-Control "no-store" always;
        try_files /dev-logout.html =404;
    }

    location @login {
        return 302 /auth/login?return=$request_uri;
    }

    location @auth_unavailable {
        default_type text/html;
        add_header Cache-Control "no-store" always;
        return 503 '<h1>Unable to verify your login</h1><p>Please try again shortly.</p>';
    }

    location ^~ /chess/ {
        auth_request /_auth_check;
        error_page 401 = @login;
        error_page 500 502 503 504 = @auth_unavailable;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ =404;
    }
    location ^~ /checkers/ {
        auth_request /_auth_check;
        error_page 401 = @login;
        error_page 500 502 503 504 = @auth_unavailable;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ =404;
    }
    location ^~ /backgammon/ {
        auth_request /_auth_check;
        error_page 401 = @login;
        error_page 500 502 503 504 = @auth_unavailable;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ =404;
    }
    location ^~ /solitaire/ {
        auth_request /_auth_check;
        error_page 401 = @login;
        error_page 500 502 503 504 = @auth_unavailable;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ =404;
    }
    location ^~ /sudoku/ {
        auth_request /_auth_check;
        error_page 401 = @login;
        error_page 500 502 503 504 = @auth_unavailable;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ =404;
    }

    location / { try_files $uri $uri/ =404; }
}
